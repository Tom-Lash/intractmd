# IntractMD v2 — copy to .env and fill in real values.

# ── Clerk authentication ───────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Partner feed database (Render Postgres) ────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# ── Partner data feed (v2 phase 5) ─────────────────────────────────────────
# Stable HMAC key for member feed pseudonyms. CHANGING THIS BREAKS every
# partner's longitudinal member tracking — treat it as permanent.
FEED_MEMBER_ID_SECRET=<64 hex chars — generate with: openssl rand -hex 32>
# Provisions partners and issues their feed API keys.
ADMIN_API_KEY=<48 hex chars — generate with: openssl rand -hex 24>

# ── Email delivery (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_xxx

# ── Nightly Google Analytics report ────────────────────────────────────────
# Numeric GA4 property ID — NOT the G-XXXXXXX measurement ID.
# Find it in GA: Admin → Property Settings → Property ID.
GA4_PROPERTY_ID=123456789
# Service-account key JSON, base64-encoded so it survives dashboard paste:
#   base64 -i ga-service-account.json | tr -d '\n'
# The service account also needs Viewer access on the GA4 property.
GA_SERVICE_ACCOUNT_JSON=<base64 of the service-account JSON key>
# Local alternative to the above — path to the unencoded key file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/ga-service-account.json
ANALYTICS_REPORT_TO=tom@resolve.med
ANALYTICS_REPORT_FROM=IntractMD Analytics <info@mail.resolve.med>
ANALYTICS_REPORT_HOUR_UTC=3
# Set to false to disable the nightly report without a deploy.
ANALYTICS_REPORT=true

# ── Optional: AI narrative in the analytics email ──────────────────────────
# Without this the report still sends, minus the "Analysis" paragraph.
ANTHROPIC_API_KEY=sk-ant-xxx
