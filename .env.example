# IntractMD v2 — copy to .env and fill in real values.

# ── Clerk authentication ───────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Partner feed database (Render Postgres) ────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# ── Partner data feed (v2 phase 5) ─────────────────────────────────────────
# Stable HMAC key for member feed pseudonyms. CHANGING THIS BREAKS every
# partner's longitudinal member tracking — treat it as permanent.
FEED_MEMBER_ID_SECRET=<64 hex chars — generate with: openssl rand -hex 32>
# Provisions partners and issues their feed API keys.
ADMIN_API_KEY=<48 hex chars — generate with: openssl rand -hex 24>
